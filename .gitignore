# Claude Code per-session state (scheduled_tasks.lock, settings.local.json)
/.claude/

# Editor temp files
*.swp

# Python bytecode caches
__pycache__/
*.pyc

# cmd/reorg dev tool binary (built to repo root by `go build ./cmd/reorg`).
# The Go tooling stays even though the server is zig; reorg is a handy
# multi-language module-mover.
/reorg

# LynRummy compiled bundles (generated by ops/build_elm and
# ops/build_engine_js — engine_glue.js is hand-written, kept).
/games/lynrummy/elm/puzzle.js
/games/lynrummy/elm/engine.js

# Driving game bundle (generated by ops/build_driving).
/games/driving/app.js
