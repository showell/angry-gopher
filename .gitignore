# Claude Code per-session state (scheduled_tasks.lock, settings.local.json)
/.claude/

# Editor temp files
*.swp

# Python bytecode caches
__pycache__/
*.pyc


# LynRummy compiled bundles (generated by ops/build_elm and
# ops/build_engine_js — engine_glue.js is hand-written, kept).
/games/lynrummy/elm/puzzle.js
/games/lynrummy/elm/engine.js

# The retired TS driving bundle (ops/build_driving, gone since ea516760).
/games/driving/app.js

# The native Safari downloads (ops/build_downloads), a `.site` directory.
/downloads/

# Safari camera wasm core (generated by ops/build_safari_wasm).
/games/driving/safari.wasm

# Chess-toy wasm cores (generated by ops/build_chess_wasm).
/games/chess/knight.wasm
/games/chess/queens.wasm

# Delivery-router bundle (generated by ops/build_delivery).
/delivery/app.js
/delivery/node_modules
