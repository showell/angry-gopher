#!/bin/bash
# ops/reset_admin_password, end to end on this machine: a real zig-server on a
# scratch data tree. The admin logs in with the old password; the server
# stops; the password is reset with --local; the server starts again; the new
# password logs in, the old one does not, and the old hash is kept aside.
# Then the refusals: a uid 1 with no password, and a second reset that is not
# asked twice (no --yes without a terminal).
set -euo pipefail

source "$(dirname "$0")/_paths.sh"
( cd "$GOPHER_DIR/zig-server" && zig build && zig build hash-password ) >/dev/null
SERVER="$GOPHER_DIR/zig-server/zig-out/bin/zig-server"
HASHER="$GOPHER_DIR/zig-server/zig-out/bin/hash-password"

root="$(mktemp -d)"
pid=""
trap '[ -n "$pid" ] && kill "$pid" 2>/dev/null; rm -rf "$root"' EXIT
mkdir -p "$root/data/chat" "$root/auth/1"
# The key sessions are signed with, as a live data tree has.
head -c 32 /dev/urandom > "$root/data/chat/_session_secret"
printf 'Steve' > "$root/auth/1/name"
printf '%s' "old password" | "$HASHER" | tr -d '\n' > "$root/auth/1/password"
printf '2\n' > "$root/auth/next-id.txt"
printf 'data_dir = %s/data\nauth_dir = %s/auth\n' "$root" "$root" > "$root/gopher.conf"
port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')

start() {
    GOPHER_CONFIG="$root/gopher.conf" GOPHER_PORT=$port GOPHER_GAME_FLOOR=off "$SERVER" > "$root/server.log" 2>&1 &
    pid=$!
    for _ in $(seq 100); do
        curl -s -o /dev/null "http://127.0.0.1:$port/version" && return 0
        sleep 0.1
    done
    echo "FAIL the server did not start"; cat "$root/server.log"; exit 1
}
stop() { kill "$pid"; wait "$pid" 2>/dev/null || true; pid=""; }

# Whether `password` logs Steve in: a session cookie with a value.
logs_in() {
    curl -s -o /dev/null -D - --data-urlencode "name=Steve" --data-urlencode "password=$1" \
        -d "action=login&next=%2Fchat" "http://127.0.0.1:$port/login/full" \
        | grep -qi '^set-cookie: gopher_auth=[^;]'
}

failed=0
check() { local what="$1"; shift; if "$@"; then echo "ok   $what"; else echo "FAIL $what"; failed=1; fi; }
not() { ! "$@"; }

start
check "the old password logs in" logs_in "old password"
check "the new one does not, yet" not logs_in "new password"
stop

printf 'new password\n' | "$GOPHER_DIR/ops/reset_admin_password" --local "$root/auth" --yes > "$root/reset.log" 2>&1 \
    || { echo "FAIL the reset"; cat "$root/reset.log"; exit 1; }
check "the reset says it is done" grep -q 'is reset' "$root/reset.log"
check "the old hash is kept aside" test -f "$root/auth/1/password.before-reset"
check "the new hash is readable by its owner only" test "$(stat -c %a "$root/auth/1/password")" = 600

start
check "the new password logs in" logs_in "new password"
check "the old one does not" not logs_in "old password"
stop

# Refused: not asked (no terminal, no --yes); and a uid 1 with no password.
printf 'x\n' | "$GOPHER_DIR/ops/reset_admin_password" --local "$root/auth" > /dev/null 2>&1 \
    && { echo "FAIL a reset without --yes and without a terminal went ahead"; failed=1; } \
    || echo "ok   refused without --yes"
mv "$root/auth/1/password" "$root/auth/1/kept"
printf 'x\n' | "$GOPHER_DIR/ops/reset_admin_password" --local "$root/auth" --yes > /dev/null 2>&1 \
    && { echo "FAIL a uid 1 with no password was given one"; failed=1; } \
    || echo "ok   refused for a uid 1 that is not a member"
check "and none was written" not test -f "$root/auth/1/password"

[ $failed = 0 ] && echo "reset_admin_password: PASS" || { echo "reset_admin_password: FAIL"; exit 1; }
