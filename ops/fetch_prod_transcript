#!/bin/bash
# Fetch the PRODUCTION chat transcript (Steve <-> Apoorva) by delegating
# to the dogfooded read-only bot client, chat/fetch_conversation.py.
#
# Zero arguments on purpose. The Python client REQUIRES base_url be passed
# (no default), so localhost-vs-prod is never silent; this script is where
# the prod choice is made once, deliberately. It wires the explicit prod
# URL + the read-only API key so callers don't have to remember either.
#
# Exercising this (rather than raw SSH/curl into the droplet) is the point:
# it keeps the read-only API and its reference client from bit-rotting.
# The key lives at ~/.gopher_api_key (mode 600). See deploy/README.md and
# the chat-transcript-fetch memory.
set -e

source "$(dirname "$0")/_paths.sh"

KEY_FILE="$HOME/.gopher_api_key"
[ -f "$KEY_FILE" ] || { echo "missing $KEY_FILE — the read-only prod API key"; exit 1; }

# Apoorva is user id 2 — the only prod conversation today.
GOPHER_API_KEY="$(cat "$KEY_FILE")" \
  python3 "$GOPHER_DIR/chat/fetch_conversation.py" https://lynrummy.com 2
