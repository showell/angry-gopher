#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before writing a new ops/* script or composing an ad-hoc shell
# command for build / launch / test / regen, run `ops/list` to see
# what already exists.
#
# Chat subsystem leaf gate (~2s). The chat SERVER (zig) is compiled by
# ops/check_zig; this leaf checks the chat CLIENT it embeds: that
# ../chat-client is at the commit chat-client-rev pins, and that the
# client's own checks pass there (chat-client's tools/check), then the
# example bot client's syntax.

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

phase() {
    local label="$1"
    shift
    local t0=$SECONDS
    "$@"
    echo "    [phase] ${label}: $((SECONDS - t0))s"
}

# **THE CHAT CLIENT IS PINNED** (chat-client-rev, the commit this server
# expects): its scripts are embedded by path from ../chat-client, so a
# checkout at any other commit would ship unseen. A bump is a deliberate
# one-line commit, made with both hosts' checks (chat-client's README).
CLIENT_DIR="$REPO_DIR/../chat-client"
want="$(tr -d '[:space:]' < chat-client-rev)"
have="$(git -C "$CLIENT_DIR" rev-parse HEAD 2>/dev/null || echo "no checkout")"
if [ "$have" != "$want" ]; then
    echo "chat-client: ../chat-client is at $have, but chat-client-rev pins $want."
    echo "  Check out the pinned commit there, or bump chat-client-rev on purpose."
    exit 1
fi
echo "==> chat-client at the pinned $want"

# The client's own checks, from its checkout: the JS syntax, the lint, the
# resize decision, the contract and its bundle (chat-client's tools/check).
phase "chat-client" "$CLIENT_DIR/tools/check"

echo "==> chat_client.py syntax"
phase "chat-py" python3 -m py_compile chat/chat_client.py

echo
echo "Chat gate passed."
