#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before writing a new ops/* script or composing an ad-hoc shell
# command for build / launch / test / regen, run `ops/list` to see
# what already exists.
#
# Chat subsystem leaf gate (~1s). The chat SERVER (server/chat) is Go,
# so it's covered by `go build` in ops/test_go; this leaf lints the chat
# CLIENT artifacts that nothing else checks — the embedded chat.js and
# the example bot client. No Go unit tests for chat yet: we're iterating
# fast and dogfooding catches the shallow bugs.

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

phase() {
    local label="$1"
    shift
    local t0=$SECONDS
    "$@"
    echo "    [phase] ${label}: $((SECONDS - t0))s"
}

echo "==> chat.js syntax"
phase "chat-js" node --check chat/chat.js

echo "==> chat_search.js syntax"
phase "chat-search-js" node --check chat/chat_search.js

echo "==> chat_left_sidebar.js syntax"
phase "chat-left-sidebar-js" node --check chat/chat_left_sidebar.js

echo "==> chat_add_topic.js syntax"
phase "chat-add-topic-js" node --check chat/chat_add_topic.js

echo "==> chat_drag_to_pin.js syntax"
phase "chat-drag-to-pin-js" node --check chat/chat_drag_to_pin.js

echo "==> chat_right_sidebar.js syntax"
phase "chat-right-sidebar-js" node --check chat/chat_right_sidebar.js

echo "==> chat_compose.js syntax"
phase "chat-compose-js" node --check chat/chat_compose.js

echo "==> chat_help.js syntax"
phase "chat-help-js" node --check chat/chat_help.js

echo "==> message.js syntax"
phase "message-js" node --check chat/message.js

echo "==> message_view.js syntax"
phase "message-view-js" node --check chat/message_view.js

echo "==> chat_image_popup.js syntax"
phase "chat-image-popup-js" node --check chat/chat_image_popup.js

echo "==> chat_code_popup.js syntax"
phase "chat-code-popup-js" node --check chat/chat_code_popup.js

echo "==> docs.js syntax"
phase "docs-js" node --check chat/docs.js

echo "==> notify.js syntax"
phase "notify-js" node --check chat/notify.js

echo "==> recent.js syntax"
phase "recent-js" node --check chat/recent.js

echo "==> images.js syntax"
phase "images-js" node --check chat/images.js

echo "==> code.js syntax"
phase "code-js" node --check chat/code.js

echo "==> nav_stack.js syntax"
phase "nav-stack-js" node --check chat/nav_stack.js

echo "==> middle_pane.js syntax"
phase "middle-pane-js" node --check chat/middle_pane.js

echo "==> learn.js syntax"
phase "learn-js" node --check learn/learn.js

echo "==> callback_log.js syntax"
phase "callback-log-js" node --check learn/callback_log.js

echo "==> chat_client.py syntax"
phase "chat-py" python3 -m py_compile chat/chat_client.py

echo "==> JS paper-over + dead-code lint"
phase "js-lint" python3 tools/lint.py

echo
echo "Chat gate passed."
