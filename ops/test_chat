#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before writing a new ops/* script or composing an ad-hoc shell
# command for build / launch / test / regen, run `ops/list` to see
# what already exists.
#
# Chat subsystem leaf gate (~1s). The chat SERVER (zig) is compiled by
# ops/check_zig; this leaf lints the chat CLIENT artifacts that nothing else
# checks — the embedded chat/*.js (+ learn/*.js) and the example bot client. We
# iterate fast and dogfooding catches the shallow bugs.

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

phase() {
    local label="$1"
    shift
    local t0=$SECONDS
    "$@"
    echo "    [phase] ${label}: $((SECONDS - t0))s"
}

# Syntax-check every client script in ONE node process (vm parses without
# running). Globbed, not hand-listed, so a new chat/*.js can't slip the gate —
# and it skips the ~40ms-per-file node-startup tax of a `node --check` loop.
echo "==> JS syntax (chat/*.js + learn/*.js, batched)"
phase "js-syntax" node tools/check_js_syntax.mjs chat/*.js learn/*.js

echo "==> chat_client.py syntax"
phase "chat-py" python3 -m py_compile chat/chat_client.py

echo "==> JS paper-over + dead-code lint"
phase "js-lint" python3 tools/lint.py

echo
echo "Chat gate passed."
