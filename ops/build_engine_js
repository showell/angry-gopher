#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before writing a new ops/* script or composing an ad-hoc
# shell command for build / launch / test / regen, run
# `ops/list` to see what already exists.
#
# Bundle the LynRummy TypeScript engine into a single browser-
# loadable JS file at games/lynrummy/elm/engine.js, served by the
# /game/engine.js route. The full-game Elm client's Hint button calls
# the bundle via Elm ports + a thin JS glue (engine_glue.js).
#
# Entry point: games/lynrummy/ts/elm_api/engine_entry.ts. Esbuild
# resolves the full closure (engine_v2 + hand_play + buckets +
# classified_card_stack + rules/* + …) into one IIFE that exposes
# a single global, `LynRummyEngine`.
#
# esbuild is a pinned devDependency of games/lynrummy/ts (alongside tsc), so we
# call its local binary directly. `npx --yes` used to re-resolve esbuild on every
# call (~1s of pure overhead); the local binary skips that. Fresh checkout: it
# arrives with the `npm install` that dir already needs for tsc.
set -e

source "$(dirname "$0")/_paths.sh"

ENTRY="$GOPHER_DIR/games/lynrummy/ts/elm_api/engine_entry.ts"
OUT="$GOPHER_DIR/games/lynrummy/elm/engine.js"
ESBUILD="$GOPHER_DIR/games/lynrummy/ts/node_modules/.bin/esbuild"

if [ ! -x "$ESBUILD" ]; then
    echo "Error: esbuild not found at $ESBUILD — run \`npm install\` in games/lynrummy/ts/" >&2
    exit 1
fi

"$ESBUILD" "$ENTRY" \
    --bundle \
    --format=iife \
    --global-name=LynRummyEngine \
    --platform=browser \
    --target=es2022 \
    --outfile="$OUT" \
    >/dev/null 2>&1 \
    || { echo "Warning: engine.js bundle failed"; exit 1; }
