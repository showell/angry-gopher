#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before writing a new ops/* script or composing an ad-hoc shell
# command for build / launch / test / regen, run `ops/list` to see
# what already exists.
#
# THE PRE-COMMIT GATE (~35s warm). The whole thing: the common base
# (build + docs) plus BOTH subsystems (Lyn Rummy = Elm + TS solver,
# Chat = client lint). Each leaf runs once — no double-common. Wired to
# git's pre-commit hook via `ops/install-hooks`.
#
# While iterating on ONE subsystem, run the cheaper subsystem gate
# instead: `ops/check_chat` (~6s, skips the Lyn Rummy suites) or
# `ops/check_lynrummy` (~30s, skips the chat lint). For the slow tier
# (agent self-play + perf benches) use `ops/check_full`.

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

t0_total=$SECONDS

# Diamond floor: build + docs (shared by both subsystem gates).
./ops/check_common

# Lyn Rummy subsystem.
echo
echo "===== ops/test_elm ====="
./ops/test_elm

echo
echo "===== ops/test_ts ====="
./ops/test_ts

# Chat subsystem.
echo
echo "===== ops/test_chat ====="
./ops/test_chat

# Driving (Safari) subsystem: the baked-critter render cull gate.
echo
echo "===== ops/check_safari ====="
./ops/check_safari

# Chess toys: the Knight's Tour wasm core's native unit tests.
echo
echo "===== ops/check_chess ====="
./ops/check_chess

echo
echo "All gates passed in $((SECONDS - t0_total))s."
