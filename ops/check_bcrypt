#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before composing an ad-hoc shell command for build / test / regen, run
# `ops/list` to see what already exists.
#
# bcrypt cross-validation gate for the zig port (~1s + 2 bcrypt verifies).
# Proves the zig server's password layer is interoperable with the live Go
# site's bcrypt hashes, in BOTH directions, against committed synthetic
# fixtures. bcrypt has no eyeball backstop (a right hash and a wrong one look
# identical), so these checks ARE the sense organ.
#
#   direction 1  zig verifies Go-produced $2a$ hashes   (the migration case:
#                every live stored password is a Go hash)
#   direction 2  Go verifies zig-produced $2b$ hashes    (the rollback case)
#
# Fixtures (synthetic, committed): zig-server/bcrypt_gold.jsonl (Go-made),
# zig-server/bcrypt_zig.jsonl (zig-made). Regenerate on demand:
#   go run ./cmd/bcrypt_gold                      # rewrites bcrypt_gold.jsonl
#   (cd zig-server && zig run src/gen_bcrypt.zig) # rewrites bcrypt_zig.jsonl

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

t0=$SECONDS

echo "===== direction 1: zig verifies Go \$2a\$ hashes ====="
(cd zig-server && zig run src/check_bcrypt.zig)

echo
echo "===== direction 2: Go verifies zig \$2b\$ hashes ====="
go run ./cmd/bcrypt_check

echo
echo "bcrypt cross-validation passed in $((SECONDS - t0))s."
