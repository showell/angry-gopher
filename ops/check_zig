#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before composing an ad-hoc shell command for build / test / regen, run
# `ops/list` to see what already exists.
#
# zig-server gate: compile the whole server + run the unit tests. This is the
# "the binary compiles" floor (the role the old `go build ./...` played), now in
# zig — composed by ops/check_common, so it runs in every subsystem gate and the
# full pre-commit gate.
#
# `zig build` compiles the server, which @embedFiles the built front-end bundles
# (so they must exist first — same prerequisite the old go build had). Then two
# lints (head access, portability), and `zig build test`: every unit test in
# zig-server's build.zig (the router's, the Store's, auth's, the cookies', …).

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

# Guard the built bundles `zig build` embeds — fail with guidance rather than a
# cryptic @embedFile error. The list is build.zig's own: every asset with a
# `.built_by` is a build output, named with the script that builds it; and an
# embedded file git does not track must name one (metal-vmm QUEUE 157(d): a
# copy of the list here had lost delivery/app.js).
python3 "$REPO_DIR/tools/embedded_assets.py" check

# The `webbox` library (zig-server/src/webbox.zig) is the files it names, and
# they import std and one another only: what a program built on it gets.
echo "==> webbox library lint (its test, then the tree)"
python3 "$REPO_DIR/tools/lint_webbox_library.py" --self-test
python3 "$REPO_DIR/tools/lint_webbox_library.py"

# Poka-yoke lint: raw request-head access (req.head.target / iterateHeaders) is
# confined to http.zig, whose accessors return OWNED copies — so a head value can
# never dangle past the body read that invalidates it (the empty/wrong-author bug).
echo "==> head-access lint"
python3 "$REPO_DIR/tools/lint_head_access.py"

# Poka-yoke lint: nothing the route table reaches may reach for the host.
# router.zig is what this site serves, and gopher-metal calls it from a machine
# with no operating system — where a host dependency is not a slower path but a
# compile error. The set it checks is DERIVED from router.zig's imports, so
# there is no exemption list to rot. Its own tests run first: a lint that never
# fires looks exactly like a clean tree.
echo "==> portable lint (its tests, then the tree)"
python3 "$REPO_DIR/tools/test_lint_portable.py"
python3 "$REPO_DIR/tools/lint_portable.py"

# Poka-yoke lint: a read of the store whose failure is caught into a value
# ("", 0, null, [], a skip) makes a disk that failed look like a file that is
# not there, and four such reads lost data in one week (ef3091eb). Absence is
# store.readOrNull / statOrNull / list's own []; anything else is named or
# defended by `// absent-ok: <why>` on the line before. It follows every
# function that reads the store, directly or through others (metal-vmm QUEUE
# 114). Its own tests run first.
echo "==> store-absence lint (its tests, then the tree)"
python3 "$REPO_DIR/tools/test_lint_store_absence.py"
python3 "$REPO_DIR/tools/lint_store_absence.py"
# Caddy's body caps against zig-server/src/limits.zig: it must let through
# what the application allows.
python3 "$REPO_DIR/tools/check_caddy_limits.py"

cd "$REPO_DIR/zig-server"

# Formatted as zig fmt formats it (metal-vmm QUEUE 116), as gopher-metal's
# `zig build test` already asks: a diff is then the change, not the layout.
echo "==> zig fmt --check"
zig fmt --check src build.zig || { echo "Error: the files above are not as zig fmt formats them: run zig fmt on them." >&2; exit 1; }

t0=$SECONDS
zig build           # compile the whole server
zig build test      # run the unit tests
echo "zig-server build + unit tests passed in $((SECONDS - t0))s."
