#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before composing an ad-hoc shell command for build / test / regen, run
# `ops/list` to see what already exists.
#
# zig-server gate: compile the whole server + run the unit tests. This is the
# "the binary compiles" floor (the role the old `go build ./...` played), now in
# zig — composed by ops/check_common, so it runs in every subsystem gate and the
# full pre-commit gate.
#
# `zig build` compiles the server, which @embedFiles the built front-end bundles
# (so they must exist first — same prerequisite the old go build had). `zig build
# test` runs the pure-logic unit tests: auth's legacy-$2a$ hash read path and
# users' session-cookie HMAC verify, each pinned by a frozen in-repo vector.

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

# Guard the built bundles `zig build` embeds — fail with guidance rather than a
# cryptic @embedFile error. (The committed assets — chat/*.js, learn/*.js,
# catalogs, images — are always present; only these four are build outputs.)
for f in games/lynrummy/elm/elm.js games/lynrummy/elm/puzzle.js \
         games/lynrummy/elm/engine.js games/driving/safari.wasm; do
    [ -f "$f" ] || { echo "Error: $f missing — run ops/build_elm + ops/build_safari_wasm first (embedded by zig build)." >&2; exit 1; }
done

# Poka-yoke lint: raw request-head access (req.head.target / iterateHeaders) is
# confined to http.zig, whose accessors return OWNED copies — so a head value can
# never dangle past the body read that invalidates it (the empty/wrong-author bug).
echo "==> head-access lint"
python3 "$REPO_DIR/tools/lint_head_access.py"

cd "$REPO_DIR/zig-server"
t0=$SECONDS
zig build           # compile the whole server
zig build test      # run the unit tests
echo "zig-server build + unit tests passed in $((SECONDS - t0))s."
