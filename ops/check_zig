#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before composing an ad-hoc shell command for build / test / regen, run
# `ops/list` to see what already exists.
#
# zig-server gate: compile the whole server + run the unit tests. This is the
# "the binary compiles" floor (the role the old `go build ./...` played), now in
# zig — composed by ops/check_common, so it runs in every subsystem gate and the
# full pre-commit gate.
#
# `zig build` compiles the server, which @embedFiles the built front-end bundles
# (so they must exist first — same prerequisite the old go build had). Then two
# lints (head access, portability), and `zig build test`: every unit test in
# zig-server's build.zig (the router's, the Store's, auth's, the cookies', …).

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

# Guard the built bundles `zig build` embeds — fail with guidance rather than a
# cryptic @embedFile error. The list is build.zig's own: every asset with a
# `.built_by` is a build output, named with the script that builds it; and an
# embedded file git does not track must name one (metal-vmm QUEUE 157(d): a
# copy of the list here had lost delivery/app.js).
python3 "$REPO_DIR/tools/embedded_assets.py" check

# The `webbox` library is two modules, `webbox` and `webbox_linux`; its own
# shape is zig-webbox's to check (src/library_test.zig, in its tests below).
# Here: every angry-gopher file imports the library by name, never by path.
# The Python lints below read the source through tools/zig_source.py: its test first.
python3 "$REPO_DIR/tools/zig_source.py"
echo "==> webbox library lint (its test, then the tree)"
python3 "$REPO_DIR/tools/lint_webbox_library.py" --self-test
python3 "$REPO_DIR/tools/lint_webbox_library.py"

# The docs' cited paths and names, this repo's (shale's
# tools/doc_check.shale, by its own `zig build doc-check`; a few seconds).
echo "==> doc check (this repo's docs)"
docs_out="$(mktemp)"
(cd "$REPO_DIR/../shale" && env -u ZIG_PROGRESS zig build doc-check -- only=angry-gopher > "$docs_out" 2>&1) \
    || { grep -E 'gone |ambiguous |names gone |findings' "$docs_out" | head -9; rm -f "$docs_out"; exit 1; }
rm -f "$docs_out"

# Poka-yoke lint: raw request-head access (req.head.target / iterateHeaders) is
# confined to http.zig, whose accessors return OWNED copies — so a head value can
# never dangle past the body read that invalidates it (the empty/wrong-author bug).
echo "==> head-access lint"
python3 "$REPO_DIR/tools/lint_head_access.py"

# Poka-yoke lint: nothing the route table reaches may reach for the host.
# router.zig is what this site serves, and zig-metal-unikernel calls it from a machine
# with no operating system — where a host dependency is not a slower path but a
# compile error. The set it checks is DERIVED from router.zig's imports, so
# there is no exemption list to rot. It reads Zig's own tokens and imports, so
# a string or a comment is never code (metal-vmm QUEUE 238). Its plants run
# first: a lint that never fires looks exactly like a clean tree. Run from the
# folder holding the repos: it reads zig-webbox and shale beside this one.
echo "==> portable lint (its plants, then the tree)"
portable_budget=(--budget steps=1500000000 --budget arena_bytes=1073741824)
(cd "$REPO_DIR/.." && shale "${portable_budget[@]}" "$(basename "$REPO_DIR")/tools/lint_portable.shale" repo="$(basename "$REPO_DIR")" self_test=1)
(cd "$REPO_DIR/.." && shale "${portable_budget[@]}" "$(basename "$REPO_DIR")/tools/lint_portable.shale" repo="$(basename "$REPO_DIR")")

# Poka-yoke lint: a sealed value is made by its check alone (metal-vmm QUEUE
# 250). A checked value (player.Id, users.Uid, and webbox's http.Target)
# carries a seal of size zero that only its own file sets, so a call that
# takes one cannot be handed a value no one checked: a literal without the
# seal does not compile, and this refuses one that sets it anywhere else. Its plants run in shale's own tests.
echo "==> seal lint"
(cd "$REPO_DIR/.." && shale shale/cookbook/sealed.shale dir="$(basename "$REPO_DIR")/zig-server/src" seals=id_seal:player.zig,uid_seal:users.zig)
(cd "$REPO_DIR/.." && shale shale/cookbook/sealed.shale dir=zig-webbox/src seals=target_seal:http.zig)

# Poka-yoke lint: a read of the store whose failure is caught into a value
# ("", 0, null, [], a skip) makes a disk that failed look like a file that is
# not there, and four such reads lost data in one week (ef3091eb). Absence is
# store.readOrNull / statOrNull / list's own []; anything else is named or
# defended by `// absent-ok: <why>` on the line before. It follows every
# function that reads the store, directly or through others (metal-vmm QUEUE
# 114). Its own tests run first.
echo "==> store-absence lint (its tests, then the tree)"
python3 "$REPO_DIR/tools/test_lint_store_absence.py"
python3 "$REPO_DIR/tools/lint_store_absence.py"
# Caddy's body caps against zig-server/src/limits.zig: it must let through
# what the application allows.
python3 "$REPO_DIR/tools/check_caddy_limits.py"

# Every zig-server file holding tests is reached from a build.zig test root,
# and only tests import router_harness.zig (metal-vmm QUEUE 236). Its plants
# first, each must fire.
echo "==> test roots (its plants, then the tree)"
(cd "$REPO_DIR" && shale tools/test_roots.shale self_test=1)
(cd "$REPO_DIR" && shale tools/test_roots.shale)

cd "$REPO_DIR/zig-server"

# Formatted as zig fmt formats it (metal-vmm QUEUE 116), as zig-metal-unikernel's
# `zig build test` already asks: a diff is then the change, not the layout.
echo "==> zig fmt --check"
zig fmt --check src build.zig || { echo "Error: the files above are not as zig fmt formats them: run zig fmt on them." >&2; exit 1; }

t0=$SECONDS
zig build           # compile the whole server
zig build test      # run the unit tests
# The libraries' tests are their own builds', not zig-server's: the server
# builds against the sibling checkouts (build.zig.zon's ../../zig-webbox and
# ../../shale), so they run here.
(cd "$REPO_DIR/../zig-webbox" && zig build test)
(cd "$REPO_DIR/../shale" && zig build test)
echo "zig-server build + unit tests, and zig-webbox's and shale's unit tests, passed in $((SECONDS - t0))s."
