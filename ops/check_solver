#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before composing an ad-hoc shell command for build / test / regen, run
# `ops/list` to see what already exists.
#
# Solver gate (~25s warm): native unit tests for the zig Lyn Rummy solver
# (games/lynrummy/zig — board bridge, repair, moves, hints, self-play sim),
# the gallery puzzle gate, and the Player Two wasm wire (fresh build +
# TS-side conformance). The self-play pins (sim.zig) are the slow half:
# six full games in Debug.
set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

for f in games/lynrummy/zig/*.zig; do
    echo "==> zig test $f"
    zig test "$f"
done

# The gallery gate lives one level up so @embedFile can reach the
# curated puzzle DSLs (module roots can't cross ".."): every gallery
# puzzle must solve, definitively.
echo "==> zig test games/lynrummy/puzzle_gate.zig"
zig test games/lynrummy/puzzle_gate.zig

# Player Two end-to-end: rebuild the browser wasm from source, then
# drive board+hand scenarios through the REAL artifact (agentStep) and
# the TS lowering — the cross-language drift alarm. Building first
# means the committed solver.wasm can never go stale against zig.
echo "==> zig agent wire (build wasm + conformance)"
./ops/build_lynrummy_wasm
(cd games/lynrummy/ts && node test/test_zig_agent_step.ts)
