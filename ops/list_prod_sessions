#!/bin/bash
# List the PRODUCTION chat conversations + their sessions — the whole
# (partner × time) matrix the key-holder can see — by delegating to the
# dogfooded reference client, chat/chat_client.py.
#
# Zero arguments on purpose: this is the discovery entry point. It prints
# the JSON from GET /chat/conversations (each conversation, its sessions
# newest-first, and the `default` session). Pick a session id from here,
# then read it with `ops/fetch_prod_transcript <session>`.
#
# Like its siblings it wires the prod URL + key once; exercising it keeps
# the discovery side of the API from bit-rotting. Key at ~/.gopher_api_key.
set -e

source "$(dirname "$0")/_paths.sh"

KEY_FILE="$HOME/.gopher_api_key"
[ -f "$KEY_FILE" ] || { echo "missing $KEY_FILE — the prod API key"; exit 1; }

GOPHER_API_KEY="$(cat "$KEY_FILE")" \
  python3 "$GOPHER_DIR/chat/chat_client.py" conversations https://lynrummy.com
