#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before writing a new ops/* script or composing an ad-hoc
# shell command for build / launch / test / regen, run
# `ops/list` to see what already exists. Drifted ops scripts
# are how an hour disappears resurrecting things.
#
# Start prod Gopher server (port 9000).
set -e

source "$(dirname "$0")/_paths.sh"

lsof -ti:9000 | xargs kill -9 2>/dev/null || true
sleep 0.5

cd "$GOPHER_DIR"

# Build the front-end bundles FIRST: `go build` embeds them into the
# binary (see embed.go), so they must exist and be current.
"$(dirname "$0")/build_elm"
"$(dirname "$0")/build_driving"

COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
# Dev cache-bust: append a per-build nonce so the ?v= asset version changes
# on every restart even when edits are uncommitted (the commit alone would
# not). Prod (ops/deploy) keeps the bare commit for stable browser caching.
BUILD_ID="$COMMIT-$(date +%s)"
go build -ldflags "-X main.gitCommit=$BUILD_ID" -o gopher-server .

# Puzzles catalog is frozen — served from the committed
# games/lynrummy/puzzles/puzzles.json. To refresh, write a TS
# generator from scratch (the legacy Python puzzle_catalog.py
# was retired with the rest of the python/ subtree on
# 2026-05-04).

GOPHER_CONFIG=~/AngryGopher/gopher.conf nohup ./gopher-server > /tmp/angry-gopher.log 2>&1 &

# Wait for the server to be ready — and prove it's serving the binary we JUST
# built (its /version reports gitCommit == BUILD_ID). A plain 200 isn't enough:
# a stale/old server still answers 200, which is exactly how a "rebuild" that
# silently didn't happen masquerades as success. Insisting on BUILD_ID makes
# this script's success mean "the fresh code is live," or it fails loudly.
for i in $(seq 1 10); do
    if curl -s http://localhost:9000/version 2>/dev/null | grep -qF "\"commit\":\"$BUILD_ID\""; then
        echo "Gopher: http://localhost:9000 (ready, serving $BUILD_ID)"
        exit 0
    fi
    sleep 1
done

echo "ERROR: :9000 is not serving the build we just made ($BUILD_ID) — a stale or" >&2
echo "       wrong server may be running, or the restart failed. Check /tmp/angry-gopher.log." >&2
exit 1
