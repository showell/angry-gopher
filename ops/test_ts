#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before writing a new ops/* script or composing an ad-hoc shell
# command for build / launch / test / regen, run `ops/list` to see
# what already exists.
#
# Fast TS gate (~4s warm). Runs the TypeScript typechecker, the light TS
# conformance/unit suites, and the dead-export report. Called by `ops/check`
# and run individually during TS-side iteration.
#
# The HEAVY conformance suites (engine BFS + curated puzzles, ~11s combined)
# live in `ops/check_full` instead — Lyn Rummy is stable, so paying that on
# every commit isn't worth it; run the full gate before BFS/agent/bucket work.
# Same for the >20s tier (test_full_game.ts agent self-play).

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

phase() {
    local label="$1"
    shift
    local t0=$SECONDS
    "$@"
    echo "    [phase] ${label}: $((SECONDS - t0))s"
}

# Direct tsc (skip the npm-run wrapper's ~0.4s spawn tax). Incremental caching
# (tsconfig: tsBuildInfoFile=.tsbuildinfo, gitignored) makes a warm typecheck
# ~1.9s vs ~3.7s cold — the common iterate-and-recheck case.
echo "==> TS typecheck"
phase "typecheck" bash -c "cd games/lynrummy/ts && ./node_modules/.bin/tsc -p ."

echo "==> TS fast tests"
cd games/lynrummy/ts
phase "leaf"       node test/test_conformance_leaf.ts
phase "verbs"      node test/test_verb_to_primitives.ts
phase "plan"       node test/test_physical_plan.ts
phase "split-phys" node test/test_split_physics.ts
phase "replay"     node test/test_replay_walkthroughs.ts
phase "find-play"  node test/test_elm_find_play.ts
cd "$REPO_DIR"

echo "==> Dead-export scan"
phase "dead-ts" ./ops/find-dead-ts-exports

echo
echo "TS gate passed."
