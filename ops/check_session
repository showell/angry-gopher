#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before composing an ad-hoc shell command for build / test / regen, run
# `ops/list` to see what already exists.
#
# Session-cookie cross-validation gate for the zig port (~1s). Proves the zig
# server's read-only identity layer agrees with the live Go site's signed
# session cookies (gopher_auth = base64url(id).issued.HMAC-SHA256), in BOTH
# directions, against committed synthetic fixtures. Like bcrypt, the HMAC is
# noise with no eyeball backstop, so these verification tables ARE the sense
# organ. The secret in every fixture is SYNTHETIC — never the live
# _session_secret.
#
#   direction 1  zig verifies Go-signed cookies   (the read-only case: every
#                live member's browser cookie was signed by Go)
#   direction 2  Go verifies zig-signed cookies    (the rollback case)
#
# Both run the REAL signer/verifier (users.SignSessionWith / VerifySessionWith
# and users.signSession / verifySessionWithSecret) — no re-implementation.
#
# Fixtures (synthetic, committed): zig-server/session_gold.jsonl (Go-made),
# zig-server/session_zig.jsonl (zig-made). Regenerate on demand:
#   go run ./cmd/session_gold                       # rewrites session_gold.jsonl
#   (cd zig-server && zig run src/gen_session.zig)  # rewrites session_zig.jsonl

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

t0=$SECONDS

echo "===== direction 1: zig verifies Go-signed session cookies ====="
(cd zig-server && zig run src/check_session.zig)

echo
echo "===== direction 2: Go verifies zig-signed session cookies ====="
go run ./cmd/session_check

echo
echo "session cross-validation passed in $((SECONDS - t0))s."
