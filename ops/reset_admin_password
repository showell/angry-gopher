#!/bin/bash
# THE ADMIN'S PASSWORD, RESET WITHOUT A SESSION (gopher-metal QUEUE.md item 89).
#
#   ops/reset_admin_password                  prod: deploy/deploy.conf's host
#   ops/reset_admin_password --local AUTH_DIR an auth directory here (a test,
#                                             or a restored copy)
#
# The admin is uid 1 (admin_ui.zig). This shows uid 1's name and asks before
# changing anything, asks for the new password twice, and hashes it HERE with
# zig-out/bin/hash-password (the server's own bcrypt, cost 10): only the hash
# leaves this machine. On prod the server is stopped while the file is
# replaced, and started again; the old hash is kept beside it as
# password.before-reset, so a mistake can be undone by hand.
#
# Nothing is stored in the repository, and no request to the server can do
# this: it needs ssh to the host, or the files themselves.
#
# Not a terminal on stdin (a test): the password is the first line of stdin,
# asked once, and --yes skips the question about the name.
#
# Metal's way back in is its boot disk's gopher-metal.conf; see
# gopher-metal's droplet/ADMIN-PASSWORD-LOST.md.
set -euo pipefail

source "$(dirname "$0")/_paths.sh"

local_dir=""
yes=0
while [ $# -gt 0 ]; do
    case "$1" in
        --local) local_dir="$2"; shift 2 ;;
        --yes) yes=1; shift ;;
        *) echo "usage: ops/reset_admin_password [--local AUTH_DIR] [--yes]" >&2; exit 2 ;;
    esac
done

( cd "$GOPHER_DIR/zig-server" && zig build hash-password ) >&2
HASHER="$GOPHER_DIR/zig-server/zig-out/bin/hash-password"

if [ -n "$local_dir" ]; then
    on() { bash -c "$1"; }
    auth="$local_dir"
else
    source "$GOPHER_DIR/deploy/deploy.conf"
    on() { ssh "$DEPLOY_HOST" "$1"; }
    # The service's own config names the auth directory.
    conf="$(on "systemctl show -p Environment $DEPLOY_SERVICE" | sed -n 's/.*GOPHER_CONFIG=\([^ ]*\).*/\1/p')"
    [ -n "$conf" ] || { echo "reset_admin_password: $DEPLOY_SERVICE names no GOPHER_CONFIG" >&2; exit 1; }
    auth="$(on "sed -n 's/^auth_dir *= *//p' '$conf'")"
    auth="${auth:-~/Auth}"
fi

name="$(on "cat '$auth/1/name'" 2>/dev/null)" || {
    echo "reset_admin_password: $auth/1/name is not there: no uid 1 to reset" >&2; exit 1; }
on "test -f '$auth/1/password'" || {
    echo "reset_admin_password: uid 1 ($name) has no password: not a member, not the admin" >&2; exit 1; }

if [ -t 0 ]; then
    if [ $yes = 0 ]; then
        read -r -p "Reset the password of uid 1, \"$name\", in $auth? [y/N] " answer
        [ "$answer" = y ] || [ "$answer" = Y ] || { echo "nothing changed"; exit 1; }
    fi
    read -r -s -p "New password: " password; echo
    read -r -s -p "Again: " again; echo
    [ "$password" = "$again" ] || { echo "reset_admin_password: they differ; nothing changed" >&2; exit 1; }
else
    [ $yes = 1 ] || { echo "reset_admin_password: not a terminal: pass --yes to change uid 1 ($name)" >&2; exit 2; }
    IFS= read -r password || true
fi

hash="$(printf '%s' "$password" | "$HASHER")"
case "$hash" in
    '$2'?'$'??'$'*) ;;
    *) echo "reset_admin_password: hash-password did not answer a bcrypt hash" >&2; exit 1 ;;
esac

# The hash rides on stdin, never on a command line another user could see.
replace="set -e; umask 077; cp -p '$auth/1/password' '$auth/1/password.before-reset';
         cat > '$auth/1/password.new'; mv '$auth/1/password.new' '$auth/1/password'"
if [ -n "$local_dir" ]; then
    printf '%s' "$hash" | on "$replace"
else
    printf '%s' "$hash" | on "sudo systemctl stop $DEPLOY_SERVICE; $replace; sudo systemctl start $DEPLOY_SERVICE"
fi
echo "the password of uid 1, \"$name\", is reset (the old hash is $auth/1/password.before-reset)"
