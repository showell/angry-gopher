#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before composing an ad-hoc shell command for build / test / regen, run
# `ops/list` to see what already exists.
#
# Publish a zig self-play CUT STATE as a playable local session (~10s):
# cut_dump.zig plays its specimen seed (the constant in that file),
# dumps the state at the first solver give-up, and publish_cut_game.ts
# lays it out and writes a fresh session under games/lynrummy/data.
# Prints the /game/<id> URL to play from where the machine ran out.
set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

cd "$REPO_DIR/games/lynrummy/zig"
BIN=/tmp/lynrummy_cut_dump
zig build-exe -O ReleaseFast -femit-bin="$BIN" cut_dump.zig
"$BIN" 2> /tmp/lynrummy_cut.dsl

cd "$REPO_DIR/games/lynrummy/ts"
node publish_cut_game.ts
