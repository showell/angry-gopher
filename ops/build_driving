#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before writing a new ops/* script or composing an ad-hoc
# shell command for build / launch / test / regen, run
# `ops/list` to see what already exists.
#
# Bundle the driving game's TypeScript into a single browser-
# loadable JS file at games/driving/app.js, served by the
# /driving/app.js route and embedded into the binary (build.zig @embedFile).
#
# Entry point: games/driving/main.ts. Esbuild resolves the whole
# closure (model + view + tree + critter + horizon) into one IIFE.
# The page itself is a near-empty shell (server/driving + the
# standalone index.html); main.ts builds its own canvas/DOM.
#
# esbuild is a pinned devDependency of games/driving (alongside tsc), so we call
# its local binary directly. `npx --yes` used to re-resolve esbuild on every call
# (~1s of pure overhead); the local binary skips that. Fresh checkout: it arrives
# with the `npm install` that dir already needs for tsc.
set -e

source "$(dirname "$0")/_paths.sh"

ENTRY="$GOPHER_DIR/games/driving/main.ts"
OUT="$GOPHER_DIR/games/driving/app.js"
ESBUILD="$GOPHER_DIR/games/driving/node_modules/.bin/esbuild"

if [ ! -x "$ESBUILD" ]; then
    echo "Error: esbuild not found at $ESBUILD — run \`npm install\` in games/driving/" >&2
    exit 1
fi

"$ESBUILD" "$ENTRY" \
    --bundle \
    --format=iife \
    --platform=browser \
    --target=es2022 \
    --outfile="$OUT" \
    >/dev/null 2>&1 \
    || { echo "Warning: app.js bundle failed"; exit 1; }
