#!/bin/bash
# CANONICAL DEV-LOOP SCRIPT — DO NOT REINVENT.
# Before composing an ad-hoc shell command for build / test / regen, run
# `ops/list` to see what already exists.
#
# Chess-toys gate: run each toy's unit tests natively (the same roots that
# ship as wasm — pure logic, so `zig test` covers them; the shared tape
# substrate is exercised through every root). Pins graph shapes, completion,
# the exact event counts that freeze move orderings, and scrub round-trips.
set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

for toy in games/chess/*.zig; do
    echo "==> zig test $toy"
    zig test "$toy"
done
