#!/bin/bash
# CANONICAL DEPLOY SCRIPT — DO NOT REINVENT.
#
# Build the zig server + front-end bundles locally, rsync the single
# self-contained binary to the production droplet, then restart the
# systemd service. The host runs no zig/Go/Node/Elm toolchain — it only
# runs the binary. The zig binary is STATICALLY LINKED and embeds every
# asset at compile time (build.zig @embedFile), so there are no runtime
# file dependencies and no working-dir assumptions.
#
# Build ordering: the Elm/TS/driving bundles must exist BEFORE `zig build`,
# because build.zig bakes them in at compile time. The build scripts handle
# their own prerequisites.
#
# Refuses to run with a dirty working tree and pushes HEAD to GitHub
# first, so we never deploy code that isn't committed AND pushed.
#
# Host coordinates live in deploy/deploy.conf. One-time host setup
# (Caddy -> localhost:9001, the systemd unit, gopher.conf) is documented
# in deploy/README.md. zig listens on :9001 (hardcoded in server.zig) and
# reads data_dir/auth from $GOPHER_CONFIG.
set -e

source "$(dirname "$0")/_paths.sh"
source "$GOPHER_DIR/deploy/deploy.conf"

cd "$GOPHER_DIR"

# Never deploy code that isn't committed AND pushed to GitHub.
if [ -n "$(git status --porcelain)" ]; then
    echo "Error: uncommitted changes in the working tree — commit before deploying." >&2
    exit 1
fi
echo "Pushing HEAD to GitHub..."
git push

COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)

# Build the front-end bundles FIRST — build.zig embeds them (see build.zig).
echo "Building Elm/TS + driving bundles..."
"$GOPHER_DIR/ops/build_elm"
"$GOPHER_DIR/ops/build_driving"

# Debug build (default optimize mode). The zig server is I/O-bound — it serves
# embedded static JS, small files, and small markdown renders, with no hot
# compute loop — so LLVM's optimization passes (~72s for ReleaseSafe vs ~7s for
# Debug) buy ~nothing here. Debug also carries the FULL set of runtime safety
# checks (a superset of ReleaseSafe's), and it's the exact mode `ops/start` runs
# locally, so prod ships the build we dogfood every day. If a genuinely
# CPU-bound path ever lands in the zig server, flip back to
# `-Doptimize=ReleaseSafe` (or optimize just that path).
echo "Building zig-server ($COMMIT, Debug)..."
( cd "$GOPHER_DIR/zig-server" && zig build )
BIN="$GOPHER_DIR/zig-server/zig-out/bin/zig-server"

# The binary is self-contained + statically linked, so we ship exactly one file.
echo "Syncing to $DEPLOY_HOST:$DEPLOY_DIR ..."
rsync -avz "$BIN" "$DEPLOY_HOST:$DEPLOY_DIR/zig-server"

echo "Restarting $DEPLOY_SERVICE ..."
# Health check hits the REAL FRONT DOOR, not /driving. The first cutover went
# green on a /driving check while /login 404'd (identity issuance wasn't ported)
# — a logged-out visitor couldn't log in. /version proves the binary is the
# fresh build; /login proves the front door a stranger actually lands on works.
# (-f makes curl fail on a 4xx/5xx, so a 404 front door fails the deploy.)
ssh "$DEPLOY_HOST" "sudo systemctl restart $DEPLOY_SERVICE && sleep 1 && \
    systemctl is-active $DEPLOY_SERVICE && \
    curl -fsS http://localhost:9001/version >/dev/null && \
    curl -fsS http://localhost:9001/login >/dev/null && \
    echo 'zig front door serving on :9001 (/version + /login OK)'"

echo "Deploy complete: https://lynrummy.com/  (verify the real front door, not just /driving)"
