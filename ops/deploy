#!/bin/bash
# CANONICAL DEPLOY SCRIPT — DO NOT REINVENT.
#
# Build the zig server + front-end bundles locally, rsync the single
# self-contained binary to the production droplet, then restart the
# systemd service. The host runs no zig/Go/Node/Elm toolchain — it only
# runs the binary. The zig binary is STATICALLY LINKED and embeds every
# asset at compile time (build.zig @embedFile), so there are no runtime
# file dependencies and no working-dir assumptions.
#
# Build ordering: the Elm/TS/driving bundles must exist BEFORE `zig build`,
# because build.zig bakes them in at compile time. The build scripts handle
# their own prerequisites.
#
# Refuses to run with a dirty working tree and pushes HEAD to GitHub
# first, so we never deploy code that isn't committed AND pushed.
#
# Host coordinates live in deploy/deploy.conf. One-time host setup
# (Caddy -> localhost:9001, the systemd unit, gopher.conf) is documented
# in deploy/README.md. zig listens on :9001 (hardcoded in server.zig) and
# reads data_dir/auth from $GOPHER_CONFIG.
#
# **AFTER THE 2026-10-04 CUTOVER, METAL SERVES lynrummy.com** and prod's Linux
# gopher-server is stopped by design — two hosts writing two copies of the data
# cannot be merged (CUTOVER.md). So a deploy must NEVER start the Linux server
# unless prod says, in so many words, that Linux serves. The PROGRAM and the
# CONTENT now ship as a new gopher-metal image (built and deployed in the
# gopher-metal repo); metal serves pages/ and gallery/ from its own boot image,
# so this script does NOT ship them to prod when metal serves.
#
# **IT FAILS CLOSED** (QUEUE item 109): the Linux build-and-restart runs ONLY on
# a clean "yes, Linux serves" — the marker ~/linux-serves present on the prod
# host, ssh exit 0. Its ABSENCE is the production state (metal serves): we
# refresh the watchdog and stop. An ssh failure, or any answer we cannot read,
# REFUSES and names what it saw — it never guesses "Linux serves". CUTOVER.md's
# way back creates the marker; the cutover removes it; the watchdog
# (deploy/watchdog.py) reads the same file the same way (absent = metal serves).
set -e

source "$(dirname "$0")/_paths.sh"
source "$GOPHER_DIR/deploy/deploy.conf"

cd "$GOPHER_DIR"

# Never deploy code that isn't committed AND pushed to GitHub. (A test sets
# DEPLOY_SKIP_PUSH=1 to drive the guard without a network push.)
if [ "${DEPLOY_SKIP_PUSH:-0}" != 1 ]; then
    if [ -n "$(git status --porcelain)" ]; then
        echo "Error: uncommitted changes in the working tree — commit before deploying." >&2
        exit 1
    fi
    echo "Pushing HEAD to GitHub..."
    git push
fi

COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)

# The content trees (read at request time, not embedded). Shipped ONLY on the
# Linux build-and-restart path below: when metal serves, metal reads pages/ and
# gallery/ from its own boot image (droplet/chat.py in gopher-metal), so
# shipping them to prod would ship content that nothing there serves (QUEUE
# item 109). Each --delete is scoped to ONE tree, so the repo stays the source
# of truth and the blast radius never reaches the data tree or ~/Auth.
ship_content() {
    echo "Syncing content trees to $DEPLOY_HOST:$DEPLOY_DIR ..."
    rsync -avz --mkpath --delete "$GOPHER_DIR/pages/" "$DEPLOY_HOST:$DEPLOY_DIR/pages/"
    rsync -avz --mkpath --delete "$GOPHER_DIR/gallery/" "$DEPLOY_HOST:$DEPLOY_DIR/gallery/"
}

# The watchdog runs on the prod host (the aux box now), refreshed in BOTH modes.
# Best-effort: a hiccup here WARNs, never fails the deploy.
ship_watchdog() {
    echo "Refreshing watchdog ..."
    if scp "$GOPHER_DIR/deploy/watchdog.py" "$DEPLOY_HOST:~/watchdog.py" && \
       ssh "$DEPLOY_HOST" "sudo systemctl restart watchdog && systemctl is-active watchdog"; then
        echo "watchdog refreshed (latest watchdog.py, restarted)"
    else
        echo "WARNING: watchdog refresh failed (fix the watchdog by hand)" >&2
    fi
}

# **DOES LINUX SERVE? — fail closed** (QUEUE item 109). The Linux build-and-
# restart runs ONLY on a clean "yes": ~/linux-serves present on prod, ssh exit
# 0. `test -f` exits 0 when it is there, 1 when it is not; ssh passes that back,
# and exits 255 itself when it cannot connect. So: 0 → Linux serves; 1 → absent,
# the production state (metal serves), refresh the watchdog and stop; 255 or
# anything else → we could not tell, so REFUSE and name it — never guess "Linux
# serves". A test stubs ssh to return each code, and sets DEPLOY_GUARD_ONLY=1 to
# stop at the guard instead of running the real Linux build.
# `|| code=$?` captures the exit without `set -e` aborting on a non-zero one
# (absent is exit 1, an ssh failure 255 — both are answers we must read, not die on).
code=0
ssh "$DEPLOY_HOST" "test -f ~/linux-serves" >/dev/null 2>&1 || code=$?

if [ "$code" != 0 ]; then
    if [ "$code" = 1 ]; then
        echo "metal serves lynrummy.com (no ~/linux-serves on $DEPLOY_HOST) — the Linux server ($DEPLOY_SERVICE) stays stopped."
    elif [ "$code" = 255 ]; then
        echo "REFUSING: cannot reach $DEPLOY_HOST over ssh (exit 255) — cannot tell whether Linux serves, so NOT starting it." >&2
        exit 1
    else
        echo "REFUSING: the ~/linux-serves check returned $code — cannot tell whether Linux serves, so NOT starting it." >&2
        exit 1
    fi
    ship_watchdog
    echo "Deploy (metal-serving mode): only the watchdog was refreshed."
    echo "A PROGRAM or CONTENT change ships as a new gopher-metal image — build and"
    echo "deploy it in the gopher-metal repo (not here). The Linux server was NOT started."
    exit 0
fi

echo "prod says Linux serves (~/linux-serves present) — building and restarting $DEPLOY_SERVICE."
if [ "${DEPLOY_GUARD_ONLY:-0}" = 1 ]; then
    echo "DEPLOY_GUARD_ONLY: would build and restart the Linux server; stopping before the build."
    exit 0
fi

# Build the front-end bundles FIRST — build.zig embeds them (see build.zig).
echo "Building Elm + delivery bundles + the Safari + chess WASM cores..."
"$GOPHER_DIR/ops/build_elm"
"$GOPHER_DIR/ops/build_delivery"
"$GOPHER_DIR/ops/build_safari_wasm"
"$GOPHER_DIR/ops/build_chess_wasm"

# Build the native Linux Safari executable — a free-standing download (NOT embedded),
# rsync'd to downloads/ below and served by downloads.zig ("Linux Executable" on the
# home page). Built locally because it needs the X11 dev libs the droplet lacks.
echo "Building the native Linux Safari executable (download)..."
"$GOPHER_DIR/ops/build_safari_download"
SAFARI_BIN="$GOPHER_DIR/games/driving/zig-out/bin/safari_x11"

# Cross-build the Windows .scr screensaver — the other free-standing download offered
# on the /safari_download page. Cross-compiled from this Linux box (no Windows SDK),
# rsync'd to downloads/ below alongside the Linux binary.
echo "Cross-building the Windows Safari .scr (download)..."
"$GOPHER_DIR/ops/build_safari_windows"
SAFARI_SCR="$GOPHER_DIR/games/driving/zig-out/bin/safari.scr"

# Debug build (default optimize mode). The zig server is I/O-bound — it serves
# embedded static JS, small files, and small markdown renders, with no hot
# compute loop — so LLVM's optimization passes (~72s for ReleaseSafe vs ~7s for
# Debug) buy ~nothing here. Debug also carries the FULL set of runtime safety
# checks (a superset of ReleaseSafe's), and it's the exact mode `ops/start` runs
# locally, so prod ships the build we dogfood every day. If a genuinely
# CPU-bound path ever lands in the zig server, flip back to
# `-Doptimize=ReleaseSafe` (or optimize just that path).
echo "Building zig-server ($COMMIT, Debug)..."
# -Dcommit bakes the short-hash into the binary so /version reports the exact
# deployed commit (build.zig -> home.zig handleVersion -> watchdog-status.txt).
( cd "$GOPHER_DIR/zig-server" && zig build "-Dcommit=$COMMIT" )
BIN="$GOPHER_DIR/zig-server/zig-out/bin/zig-server"

# The binary is self-contained + statically linked. The free-standing content
# trees ride alongside it rather than inside it (markdown and images read at
# request time, NOT @embedFile'd), and each --delete is scoped to ONE tree, so
# the repo is the single source of truth for what's live and the blast radius
# never reaches the data tree or ~/Auth. Content syncs BEFORE the restart so a
# file a new route depends on is present when the fresh binary starts.
echo "Syncing to $DEPLOY_HOST:$DEPLOY_DIR ..."
rsync -avz "$BIN" "$DEPLOY_HOST:$DEPLOY_DIR/zig-server"
# The content trees (pages/, gallery/): the resume, the Safari download page,
# the home blurb, the gallery images.
ship_content
# And the native Safari download artifacts (built above) — free-standing downloads
# served by downloads.zig. They're build artifacts (gitignored, not rsync'd from a
# repo dir like the trees above), so ship the single files to downloads/; --mkpath
# creates the dir on first deploy. The Linux binary and the Windows .scr both land
# in downloads/ and back the two links on the /safari_download page.
rsync -avz --mkpath "$SAFARI_BIN" "$DEPLOY_HOST:$DEPLOY_DIR/downloads/safari-linux"
rsync -avz --mkpath "$SAFARI_SCR" "$DEPLOY_HOST:$DEPLOY_DIR/downloads/safari-windows.scr"

echo "Restarting $DEPLOY_SERVICE ..."
# Health check hits the REAL FRONT DOORS, not /driving. The first cutover went
# green on a /driving check while /login 404'd (identity issuance wasn't ported)
# — a logged-out visitor couldn't log in. /version proves the binary is the
# fresh build; the two doors prove a stranger can actually get in.
# (-f makes curl fail on a 4xx/5xx, so a 404 front door fails the deploy.)
#
# THERE ARE TWO DOORS NOW, and this check moved with them. /play is the
# name-only one that /game and /puzzles send you to; /login/full is chat's
# password gate. Checking /login would be checking the shim that redirects to
# /play — it answers 303, which -f accepts, so it would pass whatever happened
# behind it. That is the same way /driving passed last time.
#
# Poll /version (up to ~5s) instead of a fixed `sleep 1`: the server binds the
# port in well under a second, so this returns as soon as it's actually up. If
# it never comes up the loop just exhausts and the real checks below fail the
# deploy.
ssh "$DEPLOY_HOST" "sudo systemctl restart $DEPLOY_SERVICE && \
    for _ in \$(seq 1 50); do curl -fsS http://localhost:9001/version >/dev/null 2>&1 && break; sleep 0.1; done && \
    systemctl is-active $DEPLOY_SERVICE && \
    curl -fsS http://localhost:9001/version >/dev/null && \
    curl -fsS http://localhost:9001/play >/dev/null && \
    curl -fsS http://localhost:9001/login/full >/dev/null && \
    echo 'zig front doors serving on :9001 (/version + /play + /login/full OK)'"

# Refresh the watchdog too (so the host copy never drifts from the repo).
ship_watchdog

echo "Deploy complete: https://lynrummy.com/  (verify the real front door, not just /driving)"
