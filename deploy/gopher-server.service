[Unit]
Description=Angry Gopher (Lyn Rummy) game server — zig
After=network.target

[Service]
User=steve
Group=steve
WorkingDirectory=/home/steve/angry-gopher
Environment=GOPHER_CONFIG=/home/steve/AngryGopher/gopher.conf
# The zig server (statically linked, assets embedded). Listens on :9001;
# reads data_dir/auth from GOPHER_CONFIG.
ExecStart=/home/steve/angry-gopher/zig-server
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
