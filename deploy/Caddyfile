# Angry Gopher (Lyn Rummy) reverse proxy.
#
# Live at https://lynrummy.com — Caddy auto-provisions and renews the
# Let's Encrypt cert and redirects HTTP->HTTPS. (.com is not HSTS-
# preloaded, unlike .app, so we set the HSTS header ourselves below.)
#
# /admin is gated by the Go app (the admin flag on the user); no proxy
# basic-auth. To test on the bare droplet IP (no TLS), set the site
# address to `:80`.
lynrummy.com {
	encode gzip

	# Coarse outer caps. The Go handlers enforce tighter per-route limits
	# (256 KB new-session, 64 KB append/puzzle). Chat image uploads need
	# headroom: Gopher caps the decoded image at 10 MiB, so give the upload
	# route 12 MB and keep everything else tight. The route is path-style —
	# POST /chat/c/<conv>/<sid>/upload — so match it with a regexp; the two
	# matchers are exact complements, so precisely one cap applies per request.
	@upload path_regexp up ^/chat/c/[^/]+/[^/]+/upload$
	request_body @upload {
		max_size 12MB
	}
	@notupload not path_regexp nup ^/chat/c/[^/]+/[^/]+/upload$
	request_body @notupload {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# The zig server listens on :9001 (the Go server used :9000). zig replaces
	# Go; they never run together, so this points at exactly one backend.
	reverse_proxy localhost:9001
}
