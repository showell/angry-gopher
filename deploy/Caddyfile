# Angry Gopher (Lyn Rummy) reverse proxy.
#
# Live at https://lynrummy.com — Caddy auto-provisions and renews the
# Let's Encrypt cert and redirects HTTP->HTTPS. (.com is not HSTS-
# preloaded, unlike .app, so we set the HSTS header ourselves below.)
#
# /admin is gated by the app itself, not the proxy. Testing on the bare
# droplet IP with the site address set to `:80` (no TLS) serves pages, but
# signs no one in: every cookie the app sets is Secure, and the identity ones
# are `__Host-` (metal-vmm QUEUE 162.2, 167.5), which a browser keeps only
# over HTTPS (localhost aside, in Chrome and Firefox). Test signing in over
# HTTPS: a hostname with its own certificate, or `tls internal`.

# **A HANDSHAKE THAT NAMES NO HOST** (a scanner's, to the bare address: no
# browser leaves SNI out) is given the bare address's certificate, so it
# reaches the catch-all below and its log, whichever address it came in on.
#
# **NEVER TRUSTED** (the box, installing 221): `tls internal` below would have
# Caddy try to put its own root in prod's trust store at every reload, and
# log an error when it can't. We never want it trusted.
{
	default_sni 162.243.1.123
	skip_install_trust
}

# **EVERY SITE LOGS** (metal-vmm QUEUE 221, Steve: "we should have more
# visibility" for scanners): each site block on this host, here and in
# /etc/caddy/sites/, imports this with its short name, `import access_log
# <name>`, and writes every request, as Caddy saw it, to
# /var/log/caddy/<name>-access.log: JSON, a line a request, rolled at 10 MiB,
# five kept. deploy/check_caddy_logs.py fails on a site block without it.
# Defined here, above the `import` of the other sites' files, so theirs see it.
#
# **MAKE EACH LOG CADDY'S FIRST** (deploy/README.md, step 5): `sudo caddy
# validate` runs as root and creates a missing log as root's, and the reload
# that follows then fails "permission denied", Caddy keeping its old config.
(access_log) {
	log {
		output file /var/log/caddy/{args[0]}-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

lynrummy.com {
	import access_log lynrummy
	encode gzip

	# Coarse outer caps. The server's handlers enforce tighter per-route limits
	# (256 KB new-session, 64 KB append/puzzle). Uploads need real headroom:
	# Gopher caps a screencast at 100 MiB (image 10 MiB) and reads up to ~101
	# MiB of multipart body, so give the upload route 110 MB and keep everything
	# else tight. The route is path-style and exists for BOTH DMs and channels —
	# POST /chat/c/<conv>/<sid>/upload AND /channel/<name>/<topic>/upload — so
	# match both with one regexp; the two matchers are exact complements, so
	# precisely one cap applies per request.
	@upload path_regexp up ^(/chat/c/[^/]+/[^/]+|/channel/[^/]+/[^/]+)/upload$
	request_body @upload {
		max_size 110MB
	}
	@notupload not path_regexp nup ^(/chat/c/[^/]+/[^/]+|/channel/[^/]+/[^/]+)/upload$
	request_body @notupload {
		max_size 1MiB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# Since 2026-10-04 the site is served by zig-metal-unikernel, on its private
	# card (zig-metal-unikernel's CUTOVER.md). The way back is `localhost:9001`, the
	# zig server on this droplet, which stays stopped while metal serves.
	reverse_proxy 10.100.0.4:80
}

# **WHAT NO SITE CLAIMS** (QUEUE 221): a scanner that asks for the bare
# address, by plain http or by https, is logged to knock-access.log and
# answered a bare 404. `tls internal` gives the bare address a certificate of
# Caddy's own, which no browser trusts and a scanner does not check, so its
# request gets as far as this log. **A TLS HANDSHAKE NAMING A HOST NO SITE
# HAS STILL FAILS BEFORE ANY LOG**: Caddy has no certificate to offer it, so
# nothing of that request reaches HTTP, and no line is written for it.
http://162.243.1.123 {
	import access_log knock
	respond 404
}
https://162.243.1.123 {
	tls internal
	import access_log knock
	respond 404
}

# The other sites on this host, one file each, which their own deploys install
# and this file never names: roc.lynrummy.com is roc-apps' ops/roc.lynrummy.com.caddy,
# installed by its site/deploy.sh. A pattern that matches no file is only a warning.
import /etc/caddy/sites/*.caddy
