// **WHAT THIS APPLICATION SERVES BESIDES ITS CODE**, in two kinds, read by
// every build of it: its own build.zig, zig-metal-unikernel's (the kernel, from
// -Dgopher-root, Phase B step 3), tools/embedded_assets.py, and the image and
// judge that lay out a machine's site disk.
//
// `.embedded`: front-end artifacts compiled in. A page embeds each with
// @embedFile("<name>"), which resolves only because a build declared it.
// Paths are relative to this directory; `built_by` names the script that
// makes one git does not track.
//
// `.site`: directories READ AT REQUEST TIME from the site's root (pages/home.txt
// is the home page, parsed per request; gallery/ its pictures; downloads/ the
// native Safari builds, made by ops/build_downloads and not in git), relative
// to the repo's root, each copied whole onto a machine's site disk. A file
// added to one is served everywhere with nothing else to change.
.{
    .embedded = .{
        // The Safari Screensaver (/driving): a zig→WASM core (ops/build_safari_wasm)
        // + its dumb plain-JS blitter. This REPLACED the old pure-TS bundle (app.js).
        .{ .name = "safari_wasm", .path = "../games/driving/safari.wasm", .built_by = "ops/build_safari_wasm" },
        .{ .name = "safari_blitter_js", .path = "../games/driving/wasm/blitter.js" },
        // Chess toys (/chess): per-toy zig→WASM search cores on one shared
        // tape substrate (ops/build_chess_wasm) + the one dumb plain-JS board
        // host. The chess_src_* entries are the SAME source files the wasm is
        // built from, re-embedded as text for /chess/code (sources-as-exhibit).
        .{ .name = "knight_wasm", .path = "../games/chess/knight.wasm", .built_by = "ops/build_chess_wasm" },
        .{ .name = "queens_wasm", .path = "../games/chess/queens.wasm", .built_by = "ops/build_chess_wasm" },
        .{ .name = "chess_board_js", .path = "../games/chess/board.js" },
        .{ .name = "chess_src_tape", .path = "../games/chess/core/tape.zig" },
        .{ .name = "chess_src_knight", .path = "../games/chess/knight.zig" },
        .{ .name = "chess_src_queens", .path = "../games/chess/queens.zig" },
        .{ .name = "delivery_app_js", .path = "../delivery/app.js", .built_by = "ops/build_delivery" },
        // The Delivery solver's zig→WASM core (ops/build_delivery_wasm,
        // committed): the routing brain behind /delivery, conformance-gated
        // bit-exact against the retired TS solver (ops/check_delivery).
        .{ .name = "delivery_solver_wasm", .path = "../delivery/solver.wasm" },
        .{ .name = "puzzle_js", .path = "../games/lynrummy/elm/puzzle.js", .built_by = "ops/build_elm" },
        // The compiled Elm full-game client (the /game surface).
        .{ .name = "game_elm_js", .path = "../games/lynrummy/elm/elm.js", .built_by = "ops/build_elm" },
        // Shared Lyn Rummy engine: the esbuild-bundled TS solver and the
        // Elm↔engine glue shim. Both /game and /puzzles load these (the game
        // for Hint + agent play, puzzles for their Hint button).
        .{ .name = "engine_js", .path = "../games/lynrummy/elm/engine.js", .built_by = "ops/build_elm" },
        .{ .name = "engine_glue_js", .path = "../games/lynrummy/elm/engine_glue.js" },
        // The zig board-bridge solver (ops/build_lynrummy_wasm): the puzzle
        // Hint button's brain — arrangement line in, human move plan out.
        .{ .name = "solver_wasm", .path = "../games/lynrummy/zig/solver.wasm" },
        // The puzzle catalogs, easiest-first (1-line … 6-line). Concatenated at
        // runtime into the catalog shipped in the page flag (see puzzles.zig).
        .{ .name = "puzzle_cat_1", .path = "../games/lynrummy/conformance/curated_1line_puzzles.dsl" },
        .{ .name = "puzzle_cat_2", .path = "../games/lynrummy/conformance/curated_2line_puzzles.dsl" },
        .{ .name = "puzzle_cat_3", .path = "../games/lynrummy/conformance/curated_3line_puzzles.dsl" },
        .{ .name = "puzzle_cat_4", .path = "../games/lynrummy/conformance/curated_4line_puzzles.dsl" },
        .{ .name = "puzzle_cat_5", .path = "../games/lynrummy/conformance/curated_5line_puzzles.dsl" },
        .{ .name = "puzzle_cat_6", .path = "../games/lynrummy/conformance/curated_6line_puzzles.dsl" },
        .{ .name = "puzzle_cat_sim", .path = "../games/lynrummy/conformance/curated_sim_puzzles.dsl" },
        // Shale's landing page and tutorial (/shale/, shale_page.zig): the
        // sibling shale checkout's `zig build web`, the language compiled to
        // WebAssembly, copied in by ops/build_shale_web.
        .{ .name = "shale_learn_html", .path = "../learn_shale/learn.html", .built_by = "ops/build_shale_web" },
        .{ .name = "shale_tutorial_html", .path = "../learn_shale/tutorial.html", .built_by = "ops/build_shale_web" },
        .{ .name = "shale_lessons_js", .path = "../learn_shale/lessons.js", .built_by = "ops/build_shale_web" },
        .{ .name = "shale_run_view_js", .path = "../learn_shale/run_view.js", .built_by = "ops/build_shale_web" },
        .{ .name = "shale_highlight_js", .path = "../learn_shale/highlight.js", .built_by = "ops/build_shale_web" },
        .{ .name = "shale_js", .path = "../learn_shale/shale.js", .built_by = "ops/build_shale_web" },
        .{ .name = "shale_wasm", .path = "../learn_shale/shale.wasm", .built_by = "ops/build_shale_web" },
        .{ .name = "shale_card_svg", .path = "../learn_shale/card.svg", .built_by = "ops/build_shale_web" },
        // Shared brand/avatar assets served from /images/<file> (brand.zig).
        .{ .name = "image_cat_professor", .path = "../images/cat_professor.webp" },
    },
    .site = .{ "pages", "gallery", "downloads" },
}
