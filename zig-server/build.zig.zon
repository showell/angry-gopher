.{
    // angry-gopher's server, an application of the `webbox` library, with
    // Shale for its signed admin scripts. The library is angry-gopher's own
    // copy (webbox/, below); Shale's module is made from its checkout's
    // sources in build.zig, not through its build.
    .name = .angry_gopher,
    .version = "0.1.0",
    .fingerprint = 0xc485d60137dc1e9a,
    .minimum_zig_version = "0.17.0",
    .paths = .{ "build.zig", "build.zig.zon", "src", "webbox" },
    .dependencies = .{
        // The web-server-in-a-box library, angry-gopher's own copy of
        // zig-webbox (webbox/, its README says why), modules `webbox`,
        // `webbox_linux` and `host_io`.
        .webbox = .{ .path = "webbox" },
        // The chat's markdown dialect: the `chat-markdown` checkout
        // (../../chat-markdown from here), module `chat_markdown`.
        .chat_markdown = .{ .path = "../../chat-markdown" },
        // The chat's browser client: the `chat-client` checkout
        // (../../chat-client from here), module `chat_client`.
        .chat_client = .{ .path = "../../chat-client" },
    },
}
