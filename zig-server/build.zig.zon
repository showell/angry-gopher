.{
    // angry-gopher's server, an application of the `webbox` library, with
    // Shale for its signed admin scripts.
    .name = .angry_gopher,
    .version = "0.1.0",
    .fingerprint = 0xc485d60137dc1e9a,
    .minimum_zig_version = "0.17.0",
    .paths = .{ "build.zig", "build.zig.zon", "src" },
    .dependencies = .{
        // The web-server-in-a-box library: zig-webbox, a sibling checkout
        // of angry-gopher (../../zig-webbox from here), modules `webbox`,
        // `webbox_linux` and `host_io`.
        .webbox = .{ .path = "../../zig-webbox" },
        // Shale, the script language for the site's own data: the `shale`
        // checkout (../../shale from here), module `shale`.
        .shale = .{ .path = "../../shale" },
        // Codex Chat, Cobblestone's chat in Codex compiled to Zig, served
        // under /codex-chat: the `cobble-webbox` checkout (../../cobble-webbox
        // from here), module `codex_chat`.
        .cobble_webbox = .{ .path = "../../cobble-webbox" },
    },
}
